[Unit]
Description=Salmon PMS 前端服务
After=network.target salmon-pms-backend.service
Wants=salmon-pms-backend.service

[Service]
Type=simple
User=sannah
WorkingDirectory=/home/sannah/.openclaw/workspace-codeingman/projects/salmon-pms/frontend
Environment="PATH=/home/sannah/.nvm/versions/node/v22.22.2/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VITE_API_URL=/api"
ExecStart=/home/sannah/.nvm/versions/node/v22.22.2/bin/pnpm run dev
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
