FROM python:3.12-slim

WORKDIR /app

# 安装 uv（Python 包管理器）
RUN pip install uv

# 仅复制依赖文件，利用 Docker 缓存层
COPY pyproject.toml ./

# 安装生产依赖（不含 dev 依赖）
RUN uv pip install --system -e "."

# 复制应用代码
COPY . .

# 暴露端口
EXPOSE 8000

# 生产模式运行：4 个 worker，关闭热重载
# --workers 4 适合 2-4 核 CPU，可根据部署机配置调整
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
