# ============================================================
# Salmon PMS 生产环境变量模板
# 部署时复制为 .env 并根据实际环境修改
# 注意：此文件包含敏感信息，请勿提交到 Git！
# ============================================================

# === 数据库 ===
POSTGRES_USER=salmon
POSTGRES_PASSWORD=此处修改为强密码
POSTGRES_DB=salmon_pms
# 数据库连接地址（容器内网络，使用服务名）
DATABASE_URL=postgresql+asyncpg://salmon:此处修改为强密码@db:5432/salmon_pms

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === MinIO ===
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=salmon
MINIO_SECRET_KEY=此处修改为强密码
MINIO_BUCKET=salmon-pms

# === 安全 ===
# SECRET_KEY 用于 JWT 签名，必须随机生成且保密
# 生成命令：openssl rand -hex 32
SECRET_KEY=此处用 openssl rand -hex 32 生成

# === 调试模式 ===
# 生产环境必须设为 false
DEBUG=false

# === CORS 白名单 ===
# 填入部署机的局域网 IP 和所有可能访问的 IP
# 示例: CORS_ORIGINS=["http://192.168.1.100","http://192.168.1.101:5173"]
CORS_ORIGINS=["http://localhost"]

# === 构建信息 ===
BUILD_DATE=unknown
